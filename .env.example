# PulseWatch Environment Variables

# App Environment
NODE_ENV=development
PORT=5000
WEB_PORT=3000

# Database Connection (SQLite for zero-config dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/pulsewatch?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="pulsewatch_super_secret_jwt_key_code2026_groww"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="pulsewatch_super_secret_refresh_key_code2026"
JWT_REFRESH_EXPIRES_IN="30d"

# External Data APIs (Optional - built-in simulator works when omitted)
NSE_API_KEY="your_nse_api_key_here"
NEWS_API_KEY="your_news_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
